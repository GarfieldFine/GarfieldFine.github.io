.lucky-app#lucky-app
  style.
    #lucky-app {
      position: relative;
      min-height: 70vh;
      border-radius: 12px;
      overflow: hidden;
      background: radial-gradient(ellipse 900px 700px at 50% 30%, #fff5f5 0%, #f8f0ff 30%, #f0f4ff 60%, #f5faf5 100%);
      font-family: "Noto Sans SC", "Poppins", sans-serif;
      display: flex;
      align-items: center;
      justify-content: center;
      -webkit-font-smoothing: antialiased;
    }

    #lucky-app #bgCanvas {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      z-index: 0;
      pointer-events: none;
    }

    #lucky-app .scene {
      position: relative;
      z-index: 1;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 28px;
    }

    #lucky-app .bubbles-area {
      position: relative;
      width: 480px;
      height: 380px;
    }

    #lucky-app .bubble {
      position: absolute;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 30%, rgba(255,255,255,0.55) 0%, rgba(255,255,255,0.18) 45%, rgba(255,255,255,0.04) 100%);
      border: 1px solid rgba(255,255,255,0.35);
      box-shadow: 0 6px 20px rgba(0,0,0,0.05), inset 0 0 40px rgba(255,255,255,0.35), inset 0 -4px 12px rgba(0,0,0,0.03);
      will-change: transform, opacity;
      pointer-events: none;
    }

    #lucky-app .bubble::after {
      content: "";
      position: absolute;
      top: 18%;
      left: 22%;
      width: 26%;
      height: 20%;
      border-radius: 50%;
      background: rgba(255,255,255,0.6);
      filter: blur(2px);
    }

    #lucky-app .card-wrapper {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) scale(0.9);
      opacity: 0;
      pointer-events: none;
      z-index: 2;
      transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.5s ease-out;
    }

    #lucky-app .card-wrapper.revealed {
      transform: translate(-50%, -50%) scale(1);
      opacity: 1;
      pointer-events: auto;
    }

    #lucky-app .card {
      width: 320px;
      min-height: 160px;
      padding: 36px 32px;
      border-radius: 20px;
      background: rgba(255,255,255,0.28);
      backdrop-filter: blur(20px);
      -webkit-backdrop-filter: blur(20px);
      border: 1px solid rgba(255,255,255,0.4);
      box-shadow: 0 8px 40px rgba(0,0,0,0.07), 0 0 0 1px rgba(255,255,255,0.15) inset;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      animation: cardBreathe 4s ease-in-out infinite;
    }

    @keyframes cardBreathe {
      0%, 100% { box-shadow: 0 8px 40px rgba(0,0,0,0.07), 0 0 60px rgba(255,180,150,0.08), 0 0 0 1px rgba(255,255,255,0.15) inset; }
      50% { box-shadow: 0 8px 40px rgba(0,0,0,0.1), 0 0 80px rgba(255,180,150,0.18), 0 0 0 1px rgba(255,255,255,0.2) inset; }
    }

    #lucky-app .card-text {
      font-family: "KaiTi", "STKaiti", "Noto Serif SC", "Songti SC", serif;
      font-size: 22px;
      font-weight: 700;
      color: #3d2c2c;
      letter-spacing: 2px;
      line-height: 1.8;
      transition: filter 0.6s ease-out;
      filter: blur(0px);
    }

    #lucky-app .card-text.blurred {
      filter: blur(6px);
    }

    #lucky-app .draw-btn {
      background: rgba(255,255,255,0.35);
      backdrop-filter: blur(12px);
      -webkit-backdrop-filter: blur(12px);
      border: 1px solid rgba(255,255,255,0.4);
      padding: 14px 48px;
      border-radius: 50px;
      font-size: 18px;
      font-weight: 700;
      color: #5a3e3e;
      cursor: pointer;
      box-shadow: 0 4px 20px rgba(0,0,0,0.06);
      transition: all 0.25s ease;
      letter-spacing: 2px;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
    }

    #lucky-app .draw-btn:hover {
      transform: translateY(-2px);
      box-shadow: 0 8px 28px rgba(0,0,0,0.1);
      background: rgba(255,255,255,0.5);
    }

    #lucky-app .draw-btn:active {
      transform: scale(0.96);
      transition: transform 0.1s ease;
    }

    #lucky-app .draw-btn.disabled {
      opacity: 0.5;
      cursor: not-allowed;
      pointer-events: none;
    }

    #lucky-app .draw-btn.hidden {
      opacity: 0;
      pointer-events: none;
      transform: translateY(8px);
      transition: opacity 0.4s ease, transform 0.4s ease;
    }

    #lucky-app .actions {
      display: flex;
      gap: 12px;
      align-items: center;
      opacity: 0;
      transform: translateY(10px);
      pointer-events: none;
      transition: opacity 0.5s ease 0.3s, transform 0.5s ease 0.3s;
    }

    #lucky-app .actions.visible {
      opacity: 1;
      transform: translateY(0);
      pointer-events: auto;
    }

    #lucky-app .action-btn {
      background: rgba(255,255,255,0.35);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border: 1px solid rgba(255,255,255,0.3);
      padding: 10px 20px;
      border-radius: 50px;
      font-size: 14px;
      font-weight: 600;
      color: #5a3e3e;
      cursor: pointer;
      box-shadow: 0 3px 12px rgba(0,0,0,0.05);
      transition: all 0.2s ease;
      -webkit-tap-highlight-color: transparent;
      user-select: none;
      min-width: 44px;
      min-height: 44px;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    #lucky-app .action-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 18px rgba(0,0,0,0.08);
      background: rgba(255,255,255,0.5);
    }

    #lucky-app .action-btn:active {
      transform: scale(0.95);
    }

    #lucky-app .action-btn.fav-btn.active {
      color: #e85c89;
      background: rgba(255,200,210,0.35);
    }

    #lucky-app .status-text {
      font-size: 13px;
      color: rgba(0,0,0,0.35);
      letter-spacing: 1px;
    }

    @media (max-width: 600px) {
      #lucky-app .bubbles-area {
        width: 300px;
        height: 280px;
      }

      #lucky-app .card {
        width: 270px;
        min-height: 130px;
        padding: 28px 24px;
      }

      #lucky-app .card-text {
        font-size: 18px;
      }

      #lucky-app .draw-btn {
        padding: 12px 36px;
        font-size: 16px;
      }

      #lucky-app .action-btn {
        padding: 8px 16px;
        font-size: 13px;
      }

      #lucky-app .scene {
        gap: 20px;
      }
    }


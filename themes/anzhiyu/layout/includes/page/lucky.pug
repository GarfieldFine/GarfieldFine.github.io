      let isMobile = window.matchMedia('(max-width: 600px)').matches;
      let bubbles = [];
      let bgParticles = [];
      let animMode = 'float';
      let convergeStart = 0;
      let convergeDuration = 1200;
      let rafId = null;
      let currentMsg = '';

      function todayStr(){ const d = new Date(); return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`; }
      function pickRandom(){ return MESSAGES[Math.floor(Math.random()*MESSAGES.length)]; }
      function loadFavs(){ try{ return JSON.parse(localStorage.getItem(KEY_FAVS)||'[]'); } catch(e){ return []; } }
      function saveFavs(arr){ localStorage.setItem(KEY_FAVS, JSON.stringify(arr)); }

      function resizeCanvas(){
        canvas.width = app.clientWidth;
        canvas.height = app.clientHeight;
        isMobile = window.matchMedia('(max-width: 600px)').matches;
      }

      function initBgParticles(){
        bgParticles = [];
        const count = isMobile ? 25 : 45;
        for(let i=0;i<count;i++){
          bgParticles.push({
            x: Math.random()*canvas.width,
            y: Math.random()*canvas.height,
            size: 1.2+Math.random()*2.2,
            speed: 0.15+Math.random()*0.4,
            opacity: 0.2+Math.random()*0.4,
            hue: 25+Math.random()*30,
            phase: Math.random()*Math.PI*2
          });
        }
      }

      function drawBg(ts){
        ctx.clearRect(0,0,canvas.width,canvas.height);
        bgParticles.forEach(p => {
          p.y -= p.speed;
          if(p.y < -10){ p.y = canvas.height+10; p.x = Math.random()*canvas.width; }
          const alpha = p.opacity*(0.7+0.3*Math.sin(ts*0.001+p.phase));
          ctx.save();
          ctx.globalAlpha = alpha;
          ctx.fillStyle = `hsl(${p.hue},70%,65%)`;
          ctx.beginPath();
          ctx.arc(p.x, p.y, p.size, 0, Math.PI*2);
          ctx.fill();
          ctx.restore();
        });
      }

      function spawnBurst(cx, cy){
        const count = isMobile ? 12 : 20;
        for(let i=0;i<count;i++){
          const angle = Math.random()*Math.PI*2;
          const speed = 1.2+Math.random()*2.5;
          const hues = [14,22,40,50,340,350];
          const hue = hues[Math.floor(Math.random()*hues.length)];
          bgParticles.push({
            x: cx, y: cy,
            vx: Math.cos(angle)*speed,
            vy: Math.sin(angle)*speed,
            size: 1.5+Math.random()*3,
            life: 0, maxLife: 22+Math.random()*20,
            hue,
            opacity: 0.6+Math.random()*0.4
          });
        }
      }

      function createBubbles(){
        bubblesArea.innerHTML = '';
        bubbles = [];
        const w = bubblesArea.clientWidth;
        const h = bubblesArea.clientHeight;
        const count = isMobile ? 5 : 7;
        const colors = [
          'rgba(255,200,210,0.2)',
          'rgba(220,200,255,0.2)',
          'rgba(190,215,255,0.2)',
          'rgba(255,225,180,0.2)',
          'rgba(200,235,225,0.2)',
          'rgba(255,210,195,0.2)',
          'rgba(210,220,255,0.2)'
        ];
        const sizes = isMobile
          ? [50,60,65,75,85]
          : [65,75,85,90,100,115,130];

        const positions = [];
        const margin = isMobile ? 30 : 40;
        const minDist = isMobile ? 60 : 80;

        for(let i=0;i<count;i++){
          let x, y, tries=0;
          do {
            x = margin + Math.random()*(w - margin*2 - sizes[i]);
            y = margin + Math.random()*(h - margin*2 - sizes[i]);
            tries++;
          } while(tries<50 && positions.some(p => Math.hypot(p.x-x, p.y-y) < minDist));

          positions.push({x, y});

          const el = document.createElement('div');
          el.className = 'bubble';
          el.style.cssText = `
            left:${x}px; top:${y}px;
            width:${sizes[i]}px; height:${sizes[i]}px;
            background:radial-gradient(circle at 35% 30%, rgba(255,255,255,0.5) 0%, ${colors[i]} 45%, rgba(255,255,255,0.03) 100%);
          `;
          bubblesArea.appendChild(el);

          bubbles.push({
            el,
            left: x,
            top: y,
            size: sizes[i],
            phaseX: Math.random()*Math.PI*2,
            phaseY: Math.random()*Math.PI*2,
            speedX: 0.4+Math.random()*0.6,
            speedY: 0.3+Math.random()*0.5,
            ampX: 10+Math.random()*16,
            ampY: 8+Math.random()*14,
            currentTX: 0,
            currentTY: 0
          });
        }
      }

      function easeInOutCubic(t){ return t<0.5 ? 4*t*t*t : 1-Math.pow(-2*t+2,3)/2; }

      function animate(ts){
        drawBg(ts);

        if(animMode === 'float'){
          bubbles.forEach(b => {
            b.currentTX = Math.sin(ts*0.001*b.speedX + b.phaseX)*b.ampX;
            b.currentTY = Math.cos(ts*0.001*b.speedY + b.phaseY)*b.ampY;
            b.el.style.transform = `translate(${b.currentTX}px, ${b.currentTY}px)`;
            b.el.style.opacity = '1';
          });
        } else if(animMode === 'converge'){
          const elapsed = ts - convergeStart;
          const progress = Math.min(elapsed/convergeDuration, 1);
          const eased = easeInOutCubic(progress);
          const aw = bubblesArea.clientWidth;
          const ah = bubblesArea.clientHeight;
          const cx = aw/2;
          const cy = ah/2;

          bubbles.forEach(b => {
            const bx = b.left + b.size/2;
            const by = b.top + b.size/2;
            const targetTX = cx - bx;
            const targetTY = cy - by;
            const tx = b.currentTX + (targetTX - b.currentTX)*eased;
            const ty = b.currentTY + (targetTY - b.currentTY)*eased;
            const sc = 1 - eased*0.55;
            const op = 1 - eased*0.35;
            b.el.style.transform = `translate(${tx}px, ${ty}px) scale(${sc})`;
            b.el.style.opacity = String(op);
          });

          if(progress >= 1){
            animMode = 'done';
            bubbles.forEach(b => { b.el.style.display = 'none'; });
            revealCard();
          }
        }

        // Update burst particles
        for(let i=bgParticles.length-1;i>=0;i--){
          const p = bgParticles[i];
          if(p.vx !== undefined){
            p.x += p.vx;
            p.y += p.vy;
            p.life += 1;
            if(p.life > p.maxLife) bgParticles.splice(i,1);
          }
        }

        rafId = requestAnimationFrame(animate);
      }

      function revealCard(){
        cardText.textContent = currentMsg;
        cardText.classList.add('blurred');
        cardWrapper.classList.add('revealed');
        drawBtn.classList.add('hidden');
        actionsEl.classList.add('visible');

        const cr = cardWrapper.getBoundingClientRect();
        const ar = app.getBoundingClientRect();
        spawnBurst(cr.left - ar.left + cr.width/2, cr.top - ar.top + cr.height/2);

        requestAnimationFrame(() => {
          requestAnimationFrame(() => {
            cardText.classList.remove('blurred');
          });
        });
      }

      function hideCard(){
        cardWrapper.classList.remove('revealed');
        cardText.classList.add('blurred');
        actionsEl.classList.remove('visible');
        drawBtn.classList.remove('hidden');
        currentMsg = '';
      }

      function restoreBubbles(){
        bubbles.forEach(b => {
          b.el.style.display = '';
          b.el.style.transform = 'translate(0px, 0px)';
          b.el.style.opacity = '1';
          b.currentTX = 0;
          b.currentTY = 0;
        });
        animMode = 'float';
      }

      function render(){
        const storedDate = localStorage.getItem(KEY_DATE);
        const stored = localStorage.getItem(KEY_RESULT);
        const favs = loadFavs();

        hideCard();
        restoreBubbles();

        if(stored && storedDate === todayStr()){
          statusText.textContent = '今日已抽';
          drawBtn.textContent = '已抽';
          drawBtn.classList.add('disabled');
          favBtn.classList.toggle('active', favs.includes(stored));
          currentMsg = stored;
          // Show result directly
          animMode = 'float';
          setTimeout(() => {
            bubbles.forEach(b => { b.el.style.display = 'none'; });
            revealCard();
          }, 400);
        } else {
          statusText.textContent = '今日未抽';
          drawBtn.textContent = '抽一签';
          drawBtn.classList.remove('disabled');
          favBtn.classList.remove('active');
          animMode = 'float';
        }
      }

      drawBtn.addEventListener('click', ()=>{
        if(drawBtn.classList.contains('disabled')) return;

        const storedDate = localStorage.getItem(KEY_DATE);
        if(storedDate === todayStr()){
          window.anzhiyu && anzhiyu.snackbarShow && anzhiyu.snackbarShow('今日已抽，明天再来吧');
          return;
        }

        currentMsg = pickRandom();
        localStorage.setItem(KEY_DATE, todayStr());
        localStorage.setItem(KEY_RESULT, currentMsg);
        statusText.textContent = '今日已抽';
        drawBtn.textContent = '已抽';
        drawBtn.classList.add('disabled');

        convergeStart = performance.now();
        animMode = 'converge';
      });

      resetBtn.addEventListener('click', ()=>{
        localStorage.removeItem(KEY_DATE);
        localStorage.removeItem(KEY_RESULT);
        statusText.textContent = '今日未抽';
        drawBtn.textContent = '抽一签';
        drawBtn.classList.remove('disabled');
        favBtn.classList.remove('active');
        hideCard();
        restoreBubbles();
        window.anzhiyu && anzhiyu.snackbarShow && anzhiyu.snackbarShow('已重置，可以重新抽取');
      });

      copyBtn.addEventListener('click', async ()=>{
        const txt = cardText.textContent.trim();
        if(!txt){ window.anzhiyu && anzhiyu.snackbarShow && anzhiyu.snackbarShow('还没有内容'); return; }
        try {
          await navigator.clipboard.writeText(txt);
          window.anzhiyu && anzhiyu.snackbarShow && anzhiyu.snackbarShow('已复制到剪贴板');
        } catch(e){
          window.anzhiyu && anzhiyu.snackbarShow && anzhiyu.snackbarShow('复制失败，请重试');
        }
      });

      favBtn.addEventListener('click', ()=>{
        const txt = cardText.textContent.trim();
        if(!txt){ window.anzhiyu && anzhiyu.snackbarShow && anzhiyu.snackbarShow('还没有内容'); return; }
        const favs = loadFavs();
        const idx = favs.indexOf(txt);
        if(idx>=0){
          favs.splice(idx,1);
          favBtn.classList.remove('active');
          window.anzhiyu && anzhiyu.snackbarShow && anzhiyu.snackbarShow('已取消收藏');
        } else {
          favs.push(txt);
          favBtn.classList.add('active');
          window.anzhiyu && anzhiyu.snackbarShow && anzhiyu.snackbarShow('已收藏');
        }
        saveFavs(favs);
      });

      function init(){
        resizeCanvas();
        initBgParticles();
        createBubbles();
        render();
        rafId = requestAnimationFrame(animate);
      }

      window.addEventListener('resize', ()=>{
        resizeCanvas();
        initBgParticles();
        createBubbles();
        if(animMode === 'done'){
          bubbles.forEach(b => { b.el.style.display = 'none'; });
        } else if(animMode === 'float'){
          bubbles.forEach(b => { b.currentTX = 0; b.currentTY = 0; });
        }
      });

      init();
    })();
